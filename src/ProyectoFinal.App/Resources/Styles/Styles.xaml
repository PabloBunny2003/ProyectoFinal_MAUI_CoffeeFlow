
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ESTILOS GLOBALES COFFEEFLOW -->

    <!-- Estilo de páginas -->
    <Style x:Key="CoffeePageStyle"
           TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{StaticResource CoffeeCream}" />
    </Style>

    <!-- Título principal -->
    <Style x:Key="CoffeeTitleStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource CoffeeEspresso}" />
    </Style>

    <!-- Subtítulos -->
    <Style x:Key="CoffeeSubtitleStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor"
                Value="{StaticResource CoffeeTextSecondary}" />
    </Style>

    <!-- Encabezados de sección -->
    <Style x:Key="CoffeeSectionStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource CoffeeEspresso}" />
    </Style>

    <!-- Texto normal -->
    <Style x:Key="CoffeeBodyStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor"
                Value="{StaticResource CoffeeTextPrimary}" />
    </Style>

    <!-- Botón principal -->
    <Style x:Key="CoffeePrimaryButtonStyle"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource CoffeeBrown}" />
        <Setter Property="TextColor"
                Value="{StaticResource CoffeeWhite}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="20,12" />
    </Style>

    <!-- Botón secundario -->
    <Style x:Key="CoffeeSecondaryButtonStyle"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource CoffeeWhite}" />
        <Setter Property="TextColor"
                Value="{StaticResource CoffeeBrown}" />
        <Setter Property="BorderColor"
                Value="{StaticResource CoffeeBrown}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Tarjetas -->
    <Style x:Key="CoffeeCardStyle"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource CoffeeWhite}" />
        <Setter Property="Stroke"
                Value="{StaticResource CoffeeBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campos de texto -->
    <Style x:Key="CoffeeEntryStyle"
           TargetType="Entry">
        <Setter Property="BackgroundColor"
                Value="{StaticResource CoffeeWhite}" />
        <Setter Property="TextColor"
                Value="{StaticResource CoffeeEspresso}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource CoffeeMuted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Indicadores numéricos -->
    <Style x:Key="CoffeeMetricStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource CoffeeEspresso}" />
    </Style>

</ResourceDictionary>


