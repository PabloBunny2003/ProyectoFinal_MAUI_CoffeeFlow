<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ====================================== -->
    <!-- PALETA DE COLORES COFFEEFLOW           -->
    <!-- ====================================== -->

    <!-- Colores principales -->

    <Color x:Key="CoffeeEspresso">#38251D</Color>
    <Color x:Key="CoffeeBrown">#6F4E37</Color>
    <Color x:Key="CoffeeCaramel">#C49A6C</Color>
    <Color x:Key="CoffeeCream">#F5EFE6</Color>
    <Color x:Key="CoffeeWhite">#FFFFFF</Color>

    <!-- Colores de texto -->

    <Color x:Key="CoffeeTextPrimary">#38251D</Color>
    <Color x:Key="CoffeeTextSecondary">#79695F</Color>

    <!-- Colores de estado -->

    <Color x:Key="CoffeeSuccess">#557C55</Color>
    <Color x:Key="CoffeeWarning">#B7791F</Color>
    <Color x:Key="CoffeeError">#B3261E</Color>

    <!-- Colores complementarios -->

    <Color x:Key="CoffeeBorder">#E0D6CC</Color>
    <Color x:Key="CoffeeMuted">#A89B90</Color>
    <Color x:Key="CoffeeDark">#241812</Color>

    <!-- Pinceles -->

    <SolidColorBrush x:Key="CoffeeBorderBrush"
                     Color="{StaticResource CoffeeBorder}" />

</ResourceDictionary>

