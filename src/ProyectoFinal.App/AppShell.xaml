
<Shell
    x:Class="ProyectoFinal.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProyectoFinal.App.Views"
    FlyoutBehavior="Disabled"
    Title="CoffeeFlow"
    Shell.BackgroundColor="{StaticResource CoffeeEspresso}"
    Shell.ForegroundColor="{StaticResource CoffeeWhite}"
    Shell.TitleColor="{StaticResource CoffeeWhite}"
    Shell.TabBarBackgroundColor="{StaticResource CoffeeEspresso}"
    Shell.TabBarTitleColor="{StaticResource CoffeeWhite}"
    Shell.TabBarUnselectedColor="{StaticResource CoffeeCaramel}">

    <TabBar>

        <Tab Title="Dashboard"
             Route="dashboard">

            <ShellContent
                Title="Dashboard"
                Route="DashboardPage"
                ContentTemplate="{DataTemplate views:DashboardPage}" />

        </Tab>

        <Tab Title="Productos"
             Route="productos">

            <ShellContent
                Title="Productos"
                Route="ProductosPage"
                ContentTemplate="{DataTemplate views:ProductosPage}" />

        </Tab>

    </TabBar>

</Shell>

